<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/screenTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ride Fare Estimator"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#111111" />

        <TextView
            android:id="@+id/screenSubtitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estimate a ride fare based on distance, ride type, and surge."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:id="@+id/inputCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp">

            <TextView
                android:id="@+id/distanceLabelTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Distance"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <EditText
                android:id="@+id/distanceEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter distance in km"
                android:inputType="numberDecimal"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/rideTypeLabelTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ride Type"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginTop="24dp" />

            <RadioGroup
                android:id="@+id/rideTypeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/standardRadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Standard"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/xlRadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XL" />

                <RadioButton
                    android:id="@+id/luxuryRadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Luxury" />

            </RadioGroup>

            <TextView
                android:id="@+id/selectedRideTypeTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selected ride type: Standard"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/surgeLabelTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Surge Multiplier"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginTop="24dp" />

            <SeekBar
                android:id="@+id/surgeSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="20"
                android:min="1"
                android:progress="0"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/surgeValueTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Surge: 1.0x"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/calculateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculate Fare"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/clearButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/resultTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estimated Fare"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#777777" />

            <TextView
                android:id="@+id/estimatedFareTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="$0.00"
                android:textColor="#111111"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fareBreakdownPlaceholderTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fare breakdown will appear here."
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>